{
  "name": "@lite-embeds/spotify",
  "version": "0.1.0",
  "description": "Privacy-first facade web component for Spotify embeds. Renders a static placeholder; only loads the real iframe when the user clicks.",
  "keywords": [
    "web-component",
    "custom-element",
    "spotify",
    "embed",
    "facade",
    "lite",
    "performance",
    "privacy",
    "lazy-load"
  ],
  "license": "MIT",
  "author": "Abderrahim Ghazali",
  "homepage": "https://github.com/abderrahimghazali/lite-embeds/tree/main/packages/spotify#readme",
  "bugs": "https://github.com/abderrahimghazali/lite-embeds/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/abderrahimghazali/lite-embeds.git",
    "directory": "packages/spotify"
  },
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": ["dist", "README.md", "LICENSE"],
  "sideEffects": ["./dist/index.js", "./dist/index.cjs"],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "tsup"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@lite-embeds/core": "workspace:^"
  }
}
