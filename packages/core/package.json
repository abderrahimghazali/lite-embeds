{
  "name": "@lite-embeds/core",
  "version": "0.1.0",
  "description": "Shared base class and utilities for lite-embed facade web components",
  "keywords": [
    "web-components",
    "custom-elements",
    "shadow-dom",
    "facade",
    "lazy-load",
    "performance",
    "privacy"
  ],
  "license": "MIT",
  "author": "Abderrahim Ghazali",
  "homepage": "https://github.com/abderrahimghazali/lite-embed/tree/main/packages/core#readme",
  "bugs": "https://github.com/abderrahimghazali/lite-embed/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/abderrahimghazali/lite-embed.git",
    "directory": "packages/core"
  },
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": ["dist", "README.md", "LICENSE"],
  "sideEffects": false,
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "tsup"
  },
  "publishConfig": {
    "access": "public"
  }
}
